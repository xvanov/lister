# ──────────────────────────────────────────────────────────────────────────
# Copy to .env and edit. `npm run setup` does this and fills the secret.
# Every variable is validated at boot by packages/env — a missing required
# var fails fast with a readable message instead of a runtime 500.
# ──────────────────────────────────────────────────────────────────────────

# --- identity + ports ---------------------------------------------------
# Compose names containers `<project>-<service>-1` and defaults the project to
# this directory's name. Set it explicitly, and give each app its own ports, and
# two apps generated from this template run side by side on one machine.
#
# Change a *_PORT and you must change the matching URL below it — DATABASE_URL,
# REDIS_URL and SMTP_PORT are what the app actually dials.
#
# COMPOSE_PROJECT_NAME is LEFT UNSET on purpose. Compose defaults it to this
# directory's name, which already isolates one app from another — and *setting*
# it later re-points the stack at differently-named volumes, so a running app
# appears to lose its whole database. Only set it if you know you want that.
# COMPOSE_PROJECT_NAME=
DB_PORT=5502
REDIS_PORT=6449
MAIL_SMTP_PORT=1097
MAIL_UI_PORT=8097
TEST_MAIL_SMTP_PORT=1098
TEST_MAIL_UI_PORT=8098
WEB_PORT=3240

# --- core ---------------------------------------------------------------
# NODE_ENV is deliberately NOT set here: Next.js and the test runners set it
# themselves, and a stale `development` in .env silently poisons production
# builds.

# Public origin of the web app. Also the OAuth callback host and the origin
# the mobile app talks to in a browser-based dev session.
APP_URL=http://localhost:3240

# --- database (docker compose publishes on 127.0.0.1:5502) ---------------
DATABASE_URL=postgresql://postgres:postgres@localhost:5502/app?schema=public

# --- redis / job queue (docker compose publishes on 127.0.0.1:6449) -----
REDIS_URL=redis://localhost:6449
# Jobs the worker runs in parallel (1-50).
WORKER_CONCURRENCY=5


# --- auth ---------------------------------------------------------------
# 32+ random bytes. Generate: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-openssl-rand-base64-32
BETTER_AUTH_URL=http://localhost:3240

# Google OAuth — OPTIONAL. Email+password sign-in works without it.
# To enable: console.cloud.google.com → APIs & Services → Credentials →
# Create OAuth client ID → Web application, and add BOTH redirect URIs:
#   http://localhost:3240/api/auth/callback/google
#   <your public https origin>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Extra origins allowed to complete an auth round trip, comma-separated. Needed
# when the app is reachable somewhere other than APP_URL — a Cloudflare tunnel,
# a preview deploy, your LAN address for phone testing. Explicit by design: this
# list is a CSRF boundary, so there is no wildcard.
# e.g. TRUSTED_ORIGINS=https://app.example.com,http://10.0.0.5:3240
TRUSTED_ORIGINS=

# Auth rate limiting per IP. Leave enabled everywhere — a password endpoint with
# no limiter is the cheapest attack surface you own. Raise only for load tests.
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX=100

# --- email confirmation -------------------------------------------------
# Require a confirmed address before a password sign-in works. Leave ON: it is
# the only thing stopping someone signing up as an address they do not own.
REQUIRE_EMAIL_VERIFICATION=true

# SMTP. `docker compose up -d mailpit` runs a REAL local SMTP server and inbox
# (http://localhost:8097) — no third-party account, nothing leaves the machine.
# Unset SMTP_HOST and mail is printed to the console instead, so a fresh clone
# still runs and you can copy the confirmation link out of the terminal.
#
# Mailpit shows mail; it never delivers onward. To reach real inboxes, point
# these at an SMTP relay — self-hosting an MTA strangers accept is a
# deliverability project (SPF/DKIM/DMARC, and port 25 is usually blocked).
SMTP_HOST=localhost
SMTP_PORT=1097
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Quoted deliberately: scripts/smoke.sh sources this file with `.`, and an
# unquoted `<` is a shell redirect. dotenv strips the quotes, so both readers
# are happy. Quote any value containing < > | & ( ) or spaces-with-symbols.
SMTP_FROM="Lister <no-reply@localhost>"

# Which transport sends email: smtp (the SMTP_* above; default) or resend
# (Resend's API: set RESEND_API_KEY, and SMTP_FROM on a domain verified in
# Resend; SMTP_FROM is the From of every message whichever transport sends it).
EMAIL_TRANSPORT=smtp
RESEND_API_KEY=
# Resend's webhook signing secret (whsec_..., shown when you create the
# webhook). Point ONE Resend webhook at <APP_URL>/api/webhooks/email-events
# with the email.* events: delivery status lands on outbound_message, hard
# bounces and complaints go on the suppression list, email.received becomes
# an inbound message. Unset in production = Resend's webhooks are refused.
RESEND_WEBHOOK_SECRET=



# Where the "confirm your email" screen points you in development. Set this
# whenever mail goes to a local catcher instead of the real address — otherwise
# "no email arrived" and "the email is in a different inbox" look identical.
# Use a LAN or tunnel URL if you test from a phone; localhost is not reachable
# from another device. LEAVE UNSET IN PRODUCTION.
DEV_MAIL_INBOX_URL=http://localhost:8097

# --- outbound messages (packages/outbound) -----------------------------
# EVERY outbound message (email, push, sms) passes one guard, and every attempt (sent or blocked,
# with the reason) is written to the outbound_message table.
#
# Safe mode. true = strict: only allowlisted recipients get mail; the rest
# are blocked and logged. false = off. local = allow everyone, because SMTP
# above is a catcher (Mailpit) that delivers nowhere; refused in production.
# UNSET = off in production, strict everywhere else. `local` is never
# inferred from a loopback SMTP_HOST: a local postfix relays to the internet.
# Auth mail (sign-up verification to the address being signed up) is exempt
# from the allowlist, so sign-up works in strict mode too. Operator
# notifications (below) to the configured NTFY_TOPIC / OPERATOR_EMAIL are
# exempt the same way. `local` covers email only: push and SMS are never
# caught (they reach real phones), so for them it means strict.
# This dev default assumes the Mailpit above; delete it if SMTP is real.
OUTBOUND_SAFE_MODE=local
# Comma-separated addresses, `@domain` for a whole domain, and phone numbers
# in international form (+447700900123; exact numbers only). Mobile push: an
# exact ExponentPushToken[...] entry, OR the device owner's VERIFIED account
# email (or its @domain) — so `you@yourco.com` lets your own phone get pushes.
OUTBOUND_SAFE_RECIPIENTS=
OUTBOUND_EMAIL_ENABLED=true
OUTBOUND_PUSH_ENABLED=true
# Texts cost money and reach real phones: off until you turn it on.
OUTBOUND_SMS_ENABLED=false
# Mobile push to the app (Expo push service, packages/push-mobile). Reaches
# real phones: off until you turn it on. Needs a dev-client or store build
# with the project's EAS id set (Expo Go cannot register for push).
OUTBOUND_MOBILE_PUSH_ENABLED=false
# Kill switch: true blocks everything. For an incident, prefer the runtime one,
# which needs no restart: npm run outbound:freeze -- on
OUTBOUND_FROZEN=false
# Volume caps (Redis, fixed windows). Over the cap = blocked and logged. The
# global cap applies separately to auth mail and app mail. If Redis is
# unreachable the guard fails CLOSED and nothing is sent.
OUTBOUND_CAP_RECIPIENT_PER_HOUR=10
OUTBOUND_CAP_ORG_PER_HOUR=200
OUTBOUND_CAP_ORG_PER_DAY=2000
OUTBOUND_CAP_GLOBAL_PER_HOUR=2000

# --- operator notifications (packages/notify) -------------------------
# Alerts for whoever runs the app: a job failed for good, a tenant hit the AI
# cap, a new sign-up. Every one is stored in the `notification` table. Sent by
# ntfy push when NTFY_TOPIC is set, else by email to OPERATOR_EMAIL, else
# printed to the console. Install the ntfy app and subscribe to your topic.
# Titles are prefixed with the APP_URL host, so staging and prod can share a
# phone. Never put customer data in an alert.
NTFY_URL=https://ntfy.sh
# On a public server the topic IS the password: openssl rand -hex 16
NTFY_TOPIC=
# Only for a protected topic on your own server (Bearer token).
NTFY_TOKEN=
OPERATOR_EMAIL=
# Same dedupeKey within this window = recorded, not re-sent.
NOTIFY_DEDUPE_WINDOW_MINUTES=60
# Low-priority notifications wait for a digest at these times (HH:MM,
# comma-separated, in APP_TIMEZONE).
NOTIFY_DIGEST_TIMES=09:00


# --- security helpers (packages/security) -----------------------------
# Bearer secret for HTTP cron endpoints (requireCronAuth). In production an
# unset secret refuses every call; it never leaves the endpoint open.
CRON_SECRET=
# HMAC secret for the generic (non-Resend) email webhooks: bounce/complaint
# events (/api/webhooks/email-events). Same fail-closed rule in production.
EMAIL_WEBHOOK_SECRET=
# AES-256-GCM key for sealing third-party tokens at rest (sealSecret). Generate:
# openssl rand -base64 32. To rotate, move the old key to _OLD_KEYS
# (comma-separated): values sealed with it still open, and report needsReseal.
SECRETS_ENCRYPTION_KEY=
SECRETS_ENCRYPTION_OLD_KEYS=



# How the web app formats money, dates and numbers (apps/web/src/lib/format.ts).
# Locale is BCP 47, currency ISO 4217, timezone IANA. "Today" is computed in
# APP_TIMEZONE. Defaults: en-US · USD · UTC.
APP_LOCALE=en-US
APP_CURRENCY=USD
APP_TIMEZONE=UTC

# Build version reported by /api/health. A deploy sets it to the git commit it
# deployed; leave it blank locally and the root package.json version is used.
APP_VERSION=


# --- file / media storage ----------------------------------------------
# local | s3   (s3 also covers R2, MinIO, B2 — anything S3-compatible)
STORAGE_DRIVER=local
# A RELATIVE path resolves against each process's cwd, which is not the same for
# the web app, the worker and the container. scripts/setup.sh rewrites this
# default to an absolute <repo>/storage so web and worker share one directory.
# The resolved root is logged at first use.
STORAGE_LOCAL_DIR=./storage
S3_BUCKET=
S3_REGION=auto
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=


# --- lister -------------------------------------------------------------
# API keys of the calling apps, JSON in SINGLE quotes. Example:
# `org` = the organization id (survives renames) or slug.
# LISTER_API_CLIENTS='[{"name":"garage-saler","key":"<GARAGE_TO_LISTER_API_KEY>","org":"kalin","scopes":["accounts:read","listings:read","listings:write"]}]'
LISTER_API_CLIENTS=
# Signs every webhook: X-Signature: sha256=<hex HMAC-SHA256 of the raw body>
LISTER_WEBHOOK_SECRET=
# Per-account Chromium profiles (relative = to the repo root). Gitignored.
LISTER_PROFILES_DIR=data/profiles
# playwright (real browser) | fake (simulated; the smoke gate uses it)
LISTER_BROWSER_DRIVER=playwright
# X display for accounts with headless=false, e.g. :0
LISTER_DISPLAY=
